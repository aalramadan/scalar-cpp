# Writes the C++ file that puts the data files of the tagger into a binary, and for MSVC the resource
#   script beside it. The build runs it after each change of one of the files as
#   cmake -DLIST=<file that sets BUILT_IN_FILES> -DOUTPUT=<path without extension> -DRESOURCES=<0 or 1> -P embedFiles.cmake

include("${LIST}")

set(DIRECTIVES "")
set(DECLARATIONS "")
set(ENTRIES "")
set(RESOURCE_LINES "")
set(index 0)
set(files ${BUILT_IN_FILES})
while(files)
    list(POP_FRONT files name path)
    # The path becomes a string of the assembler or of the resource compiler
    if(path MATCHES "[\"\\\\]")
        message(FATAL_ERROR "scalar_embed_files cannot build in ${path}, since its path holds a quote or a backslash.")
    endif()
    # The digest changes this source with the file, therefore a compiler cache such as ccache never
    #   serves an object with the old bytes
    file(SHA256 "${path}" digest)
    math(EXPR index "${index} + 1")
    set(label "scalar_file${index}")
    if(RESOURCES)
        string(APPEND RESOURCE_LINES "// ${name}, SHA-256 ${digest}\n${index} RCDATA \"${path}\"\n")
        string(APPEND ENTRIES "        {\"${name}\", ${index}},\n")
    else()
        string(APPEND DIRECTIVES
            "        \"/* ${name}, SHA-256 ${digest} */\\n\"\n"
            "        \".balign 64\\n\"\n"
            "        \".globl ${label}_begin\\n\"\n"
            "        \"${label}_begin:\\n\"\n"
            "        \".incbin \\\"${path}\\\"\\n\"\n"
            "        \".globl ${label}_end\\n\"\n"
            "        \"${label}_end:\\n\"\n")
        string(APPEND DECLARATIONS
            "extern \"C\" const char ${label}_begin[] __asm__(\"${label}_begin\");\n"
            "extern \"C\" const char ${label}_end[] __asm__(\"${label}_end\");\n")
        string(APPEND ENTRIES "        {\"${name}\", bytesBetween(${label}_begin, ${label}_end)},\n")
    endif()
endwhile()

set(ASSEMBLER_TEMPLATE [=[
// Generated by cmake/embedFiles.cmake. The build writes this file anew after each change of a file it names.

#include "builtInFiles.hpp"
#include "dataFile.hpp"

#include <cstddef>
#include <cstdint>
#include <iterator>
#include <string_view>

// .incbin copies the bytes of each file into the read-only data of the binary
#if defined(__APPLE__)
#define NAMECHECKER_DATA_SECTION ".const_data\n"
#elif defined(_WIN32)
#define NAMECHECKER_DATA_SECTION ".section .rdata,\"dr\"\n"
#else
#define NAMECHECKER_DATA_SECTION ".section .rodata\n"
#endif

__asm__(NAMECHECKER_DATA_SECTION
@DIRECTIVES@        ".text\n");

@DECLARATIONS@
namespace {

std::string_view bytesBetween(const char* begin, const char* end) {
    return {begin, static_cast<std::size_t>(reinterpret_cast<std::uintptr_t>(end) - reinterpret_cast<std::uintptr_t>(begin))};
}

} // namespace

void registerBuiltInFiles() {
    const scalar::BuiltInFile files[] = {
@ENTRIES@    };
    scalar::addBuiltInFiles(files, std::size(files));
}
]=])

set(RESOURCE_TEMPLATE [=[
// Generated by cmake/embedFiles.cmake. The build writes this file anew after each change of a file it names.

#include "builtInFiles.hpp"
#include "dataFile.hpp"

#include <string_view>
#include <vector>

#ifndef NOMINMAX
#define NOMINMAX
#endif
#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
#include <windows.h>

void registerBuiltInFiles() {
    // Each file is a resource of builtInFiles.rc, which Windows maps into memory with the program
    static const struct {
        const char* name;
        int         id;
    } resources[] = {
@ENTRIES@    };
    std::vector<scalar::BuiltInFile> files;
    for (const auto& resource : resources) {
        const HRSRC   info  = FindResourceW(nullptr, MAKEINTRESOURCEW(resource.id), MAKEINTRESOURCEW(10)); // RT_RCDATA
        const HGLOBAL data  = info ? LoadResource(nullptr, info) : nullptr;
        const char*   bytes = data ? static_cast<const char*>(LockResource(data)) : nullptr;
        if (bytes) files.push_back({resource.name, std::string_view(bytes, SizeofResource(nullptr, info))});
    }
    scalar::addBuiltInFiles(files.data(), files.size());
}
]=])

if(RESOURCES)
    string(CONFIGURE "${RESOURCE_TEMPLATE}" source @ONLY)
    # rc reads a script in the ANSI code page unless the script names its code page
    file(WRITE "${OUTPUT}.rc" "// Generated by cmake/embedFiles.cmake\n#pragma code_page(65001)\n${RESOURCE_LINES}")
else()
    string(CONFIGURE "${ASSEMBLER_TEMPLATE}" source @ONLY)
endif()
file(WRITE "${OUTPUT}.cpp" "${source}")
